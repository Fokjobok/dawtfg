# Copy/generate a separate .env.production. Never reuse the development key/data.
PRODUCTION_RELEASE=local
PRODUCTION_APP_HOST=training.example.test
PRODUCTION_APP_URL=https://training.example.test
PRODUCTION_APP_KEY=
PRODUCTION_DB_DATABASE=dawtfg_production
PRODUCTION_DB_USERNAME=dawtfg_production
PRODUCTION_DB_PASSWORD=
PRODUCTION_DB_ADMIN_PASSWORD=
PRODUCTION_BIND_ADDRESS=127.0.0.1
PRODUCTION_HTTP_PORT=8088
PRODUCTION_HTTPS_PORT=8443
PRODUCTION_TLS_DIR=./.secrets/production/tls
# Keep these names stable across releases. They must be different from development.
PRODUCTION_DB_VOLUME=dawtfg_production_postgres
PRODUCTION_STORAGE_VOLUME=dawtfg_production_storage
