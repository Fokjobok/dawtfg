{
  "name": "composer/composer",
  "version": "2.11.1",
  "type": "project",
  "description": "Official stable Composer source with an independently locked and audited dependency graph.",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-filter": "*",
    "ext-hash": "*",
    "ext-json": "*",
    "composer/ca-bundle": "^1.6",
    "composer/class-map-generator": "^1.8.0",
    "composer/metadata-minifier": "^1.0",
    "composer/semver": "^3.3",
    "composer/spdx-licenses": "^1.5.7",
    "composer/xdebug-handler": "^2.0.2 || ^3.0.3",
    "justinrainbow/json-schema": "^6.6.3",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "seld/jsonlint": "^1.4",
    "seld/phar-utils": "^1.2",
    "symfony/console": "^5.4.47 || ^6.4.25 || ^7.1.10 || ^8.0",
    "symfony/filesystem": "^8.1.11",
    "symfony/finder": "^5.4.45 || ^6.4.24 || ^7.1.10 || ^8.0",
    "symfony/process": "^5.4.47 || ^6.4.25 || ^7.1.10 || ^8.0",
    "react/promise": "^3.3",
    "composer/pcre": "^2.3 || ^3.3",
    "symfony/polyfill-php73": "^1.24",
    "symfony/polyfill-php80": "^1.24",
    "symfony/polyfill-php81": "^1.24",
    "symfony/polyfill-php84": "^1.30",
    "seld/signal-handler": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Composer\\": "src/Composer/"
    }
  },
  "bin": [
    "bin/composer"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
